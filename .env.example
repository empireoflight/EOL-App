VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Base URL of this app, used instead of hardcoded absolute URLs anywhere in
# the codebase (spec §3) so swapping domains later is a DNS-only change.
VITE_APP_BASE_URL=http://localhost:5173

# Server-side only (Supabase Edge Function secrets — never exposed to the
# frontend, never prefixed with VITE_). Set per-environment via
# `supabase secrets set`, one key per eol-dev/eol-staging/eol-prod project so
# dev/test traffic never touches prod usage or logs (spec §3).
# ANTHROPIC_API_KEY=sk-ant-your-key
